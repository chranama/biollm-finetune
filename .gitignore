# ============================================================
# Python / Virtual Environments
# ============================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

.venv/
venv/
env/
ENV/

# Build / Packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# pytest / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# mypy / ruff / tooling caches
.mypy_cache/
.ruff_cache/
.cache/


# ============================================================
# uv (Python project manager)
# ============================================================
.uv/


# ============================================================
# LLM / HF / Model Cache
# ============================================================
.hf/
.huggingface/
.huggingface_cache/
.cache/huggingface/
.cache/transformers/
.cache/datasets/

# Model artifacts
*.bin
*.safetensors
*.pt
*.pth


# ============================================================
# Experiment Results (auto-generated)
# ============================================================
# Keep experiment configs but ignore experiment *outputs*
results/experiments/
results/runs/
results/generated/
results/processed/
results/ckpts/

# Allow empty dirs to be committed with placeholder files
!results/**/.gitkeep


# ============================================================
# Data
# ============================================================
# Ignore raw and intermediate data unless explicitly committed
data/**/*.jsonl
data/**/*.json
data/**/*.txt
data/**/*.csv

# But DO track sample/unit test data in data/samples/
!data/samples/**


# ============================================================
# Logs and temporary files
# ============================================================
*.log
*.out
*.err
*.tmp
*.bak
*.swp
*.swo


# ============================================================
# Archive / Misc
# ============================================================
archive/
archive.zip

.DS_Store
Thumbs.db